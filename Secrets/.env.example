# ===== ตัวอย่างไฟล์ตั้งค่าลับ (.env.example) =====
# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริงของคุณ (ห้าม commit ไฟล์ .env ขึ้น git)
# ค่าด้านล่างทั้งหมดเป็นค่าปลอม/ตัวอย่างเท่านั้น (placeholder) ไม่ใช่ key จริง
#
# วิธีใช้กับแล็บ (ไม่บังคับ): ถ้าไม่ตั้งค่า env เซิร์ฟเวอร์จะใช้ค่าปลอมในตัวให้เอง
#   ตัวอย่างบน Windows PowerShell:  $env:TRANSLATE_API_KEY="sk_test_FAKE_not_a_real_key_0000"; node server.js

# API key ของบริการแปลภาษา (third-party)
TRANSLATE_API_KEY=sk_test_FAKE_not_a_real_key_0000

# ฐานข้อมูล
DB_HOST=127.0.0.1
DB_USER=app_admin
DB_PASSWORD=DEMO_FAKE_DB_PASSWORD_change_me

# ความลับสำหรับเซ็น token / session
JWT_SECRET=DEMO_FAKE_JWT_SECRET_do_not_use
SESSION_SECRET=DEMO_FAKE_SESSION_SECRET_1234

# พอร์ตของเซิร์ฟเวอร์ (ไม่บังคับ ค่าเริ่มต้นคือ 4600)
PORT=4600
